# Copy to .env next to docker-compose.yml and fill in. Keep it chmod 600.

# Hostname users will visit (no scheme). Either a domain you control with an
# A record pointing at this VM, or <public-ip>.sslip.io if you have no domain.
PAPERCLIP_DOMAIN=paperclip.example.com

# "internal" = self-signed cert (use with sslip.io / no domain), or an email
# address = publicly trusted Let's Encrypt cert (use with a real domain).
CADDY_TLS_MODE=internal

# Image to run. Pin a version tag for reproducible deploys.
PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:latest

# Database. Default: the bundled Postgres container (local-db profile).
# For a managed database (Azure Flexible Server, RDS, ...) instead:
#   COMPOSE_PROFILES=
#   DATABASE_URL=postgres://user:pass@host:5432/paperclip?sslmode=require
COMPOSE_PROFILES=local-db
#DATABASE_URL=

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Set to true after the first (admin) user has signed up, then
# `docker compose up -d` to apply. Use the invite flow for more users.
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false

# LLM provider keys — at least one is needed for agents to work.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: run the Claude Code adapter against a cheaper Anthropic-compatible
# API instead of Anthropic. Uncomment ONE block and set the provider's key in
# ANTHROPIC_API_KEY above.
#
# Kimi K2 (Moonshot — strong agentic coding, ~$0.6/M in, $2.5/M out):
#ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic
#ANTHROPIC_MODEL=kimi-k2-0905-preview
#ANTHROPIC_SMALL_FAST_MODEL=kimi-k2-turbo-preview
#
# DeepSeek (cheapest, ~$0.28/M in, $0.42/M out):
#ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#ANTHROPIC_MODEL=deepseek-chat
#ANTHROPIC_SMALL_FAST_MODEL=deepseek-chat

# Optional: lets agents work with GitHub repos.
GITHUB_TOKEN=
